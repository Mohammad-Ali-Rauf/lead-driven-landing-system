# Admin dashboard PIN (required)
ADMIN_PIN=change-this-to-a-secure-pin

# Secret used to sign the auth cookie (required)
AUTH_SECRET=a-random-secret-string

# Turso database connection (required for Vercel/Turso)
# Get these from: https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token
